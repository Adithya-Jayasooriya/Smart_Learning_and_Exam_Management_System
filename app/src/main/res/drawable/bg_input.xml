<?xml version="1.0" encoding="utf-8"?>
<!--
    THE LOOK OF EVERY INPUT FIELD (EditText/Spinner backgrounds):
    a white rounded rectangle with a thin light-grey border.
    Change @color/card for the fill or @color/field_stroke for the border
    (both defined in res/values/colors.xml).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card" />          <!-- field fill (white) -->
    <corners android:radius="12dp" />              <!-- corner roundness -->
    <stroke
        android:width="1dp"
        android:color="@color/field_stroke" />     <!-- thin border line -->
</shape>
